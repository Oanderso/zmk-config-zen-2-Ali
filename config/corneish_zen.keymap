#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };

    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        TEXT {
            display-name = "LETTER";

            // Row legends in comment are just illustrative.

            bindings = <
&kp ESC    &kp SQT   &kp COMMA  &kp DOT  &kp P      &kp Y       &kp F    &kp G      &kp C        &kp R  &kp L  &kp FSLH
&kp TAB    &kp A     &kp O      &kp E    &kp U      &kp I       &kp D    &kp H      &kp T        &kp N  &kp S  &mo 1
&kp LCTRL  &kp SEMI  &kp Q      &kp J    &kp K      &kp X       &kp B    &kp M      &kp W        &kp V  &kp Z  &kp DEL
                                &mo 2    &kp SPACE  &kp BSPC    &kp RET  &kp RSHFT  &kp LG(TAB)
            >;
        };

        SYMBOL {
            display-name = "SYMBOL";
            bindings = <
&kp GRAVE   &kp N1        &kp N2        &kp N3        &kp N4        &kp N5       &kp N6     &kp N7    &kp N8    &kp N9  &kp N0  &kp BSLH
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp HOME     &kp END    &trans    &trans    &trans  &trans  &trans
&kp RCTRL   &kp LALT      &trans        &trans        &kp LBKT      &kp MINUS    &kp EQUAL  &kp RBKT  &trans    &trans  &trans  &kp DEL
                                        &kp LGUI      &trans        &kp SPACE    &kp RET    &trans    &kp RALT
            >;
        };

        NAVI {
            display-name = "NAVI";
            bindings = <
&kp LC(Z)        &kp LC(C)  &kp UP    &kp LC(V)  &msc SCRL_UP    &kp LC(EQUAL)    &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI   &rgb_ug RGB_HUI  &kp BSPC
&kp LC(Y)        &kp LEFT   &kp DOWN  &kp RIGHT  &msc SCRL_DOWN  &kp LC(MINUS)    &rgb_ug RGB_EFR  &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD   &rgb_ug RGB_HUD  &trans
&kp PRINTSCREEN  &mkp MB3   &mkp MB1  &mkp MB2   &mkp MB4        &mkp MB5         &msc SCRL_LEFT   &msc SCRL_RIGHT  &kp C_VOL_DN     &kp C_PLAY_PAUSE  &kp C_VOLUME_UP  &rgb_ug RGB_TOG
                                      &trans     &trans          &trans           &trans           &trans           &trans
            >;
        };
    };
};
